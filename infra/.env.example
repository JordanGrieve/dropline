# Copy to infra/.env and fill in. infra/.env is ignored by git.

# The public hostname. Its DNS A record must point at the server before
# the first start, or Caddy cannot get a certificate.
DOMAIN=dropline.example.com

# Postgres password for the dropline user. Generate one:
#   openssl rand -base64 24
DB_PASSWORD=change-me

# 1 attaches the OpenTelemetry agent. Set to empty to run without it when
# the observability profile is not started.
OTEL_ENABLED=1

# How often the drop is put back to open and full, in seconds. 86400 = daily.
RESET_EVERY_SECONDS=86400
